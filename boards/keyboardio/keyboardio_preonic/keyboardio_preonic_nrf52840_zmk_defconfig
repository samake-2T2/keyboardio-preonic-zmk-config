CONFIG_BOARD_KEYBOARDIO_PREONIC=y

# Enable MPU (메모리 보호 및 안정성)
CONFIG_ARM_MPU=y

# enable GPIO
CONFIG_GPIO=y

# 로깅 비활성화 (전력 절감 및 불필요한 콘솔 출력 억제)
CONFIG_LOG=n

# 칩셋 클럭 초기화 안정화
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC_CALIBRATION=y

# USB 장치 식별 정보 (Keyboardio Preonic 정식 VID:PID)
CONFIG_USB_DEVICE_STACK=y
CONFIG_ZMK_USB=y
CONFIG_USB_DEVICE_VID=0x3496
CONFIG_USB_DEVICE_PID=0x00A1
CONFIG_USB_DEVICE_MANUFACTURER="Keyboardio"
CONFIG_USB_DEVICE_PRODUCT="Preonic"

# Bluetooth 활성화
CONFIG_ZMK_BLE=y

# Rotary encoder events (노브 동작 핵심)
CONFIG_EC11=y
CONFIG_EC11_TRIGGER_GLOBAL_THREAD=y

# 절전 (Deep Sleep) 지원
CONFIG_ZMK_SLEEP=y

# I2C 및 MAX17048 정밀 배터리 연료 게이지 드라이버
CONFIG_I2C=y
CONFIG_ZMK_MAX17048=y

# Butterfly LED Status Indicator (WS2812 / SK6812)
CONFIG_KEYBOARDIO_BUTTERFLY_STATUS=y
CONFIG_LED_STRIP=y
CONFIG_SPI=y

# 메모리 파티션 및 설정 저장소 (부팅 및 페어링 유지 핵심)
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# UF2 펌웨어 포맷 출력 활성화
CONFIG_BUILD_OUTPUT_UF2=y

# Piezo Sound Support (PWM0 on P0.22)
CONFIG_PWM=y
CONFIG_PWM_NRFX=y

# Bootloader Support (GPREGRET retention for Adafruit nRF52 UF2 bootloader)
CONFIG_RETAINED_MEM=y
CONFIG_RETENTION=y
CONFIG_RETENTION_BOOT_MODE=y
CONFIG_ZMK_BOOTMODE_MAGIC_VALUE_BOOTLOADER_TYPE_ADAFRUIT_NRF52=y

