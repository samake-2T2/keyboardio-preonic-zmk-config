#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 2400
#include <dt-bindings/zmk/pointing.h>

// 레이어 인덱스 정의

#define L_BASE  0
#define L_LOWER 1
#define L_RAISE 2
#define L_FN    3
#define L_TRI   4

// [표준 검증 완료] 마우스 가속도 설정

&mmv {
    acceleration-exponent = <2>;
    time-to-max-speed-ms = <500>;
    delay-ms = <0>;
};

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <300>;
    delay-ms = <0>;
};

&lt { quick_tap_ms = <200>; };

/ {
    macros {
        bt_sel_0: bt_sel_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 0>;
        };
        bt_sel_1: bt_sel_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 1>;
        };
        bt_sel_2: bt_sel_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 2>;
        };
        bt_sel_3: bt_sel_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "Base";
            bindings = <
                                                                                                 &kp PRINTSCREEN  &mo L_FN   &kp C_MUTE
&kp GRAVE  &kp N1    &kp N2    &kp N3    &kp N4       &kp N5     &kp N6  &kp N7       &kp N8     &kp N9           &kp N0     &kp BACKSPACE
&kp TAB    &kp Q     &kp W     &kp E     &kp R        &kp T      &kp Y   &kp U        &kp I      &kp O            &kp P      &kp BACKSLASH
&kp ESC    &kp A     &kp S     &kp D     &kp F        &kp G      &kp H   &kp J        &kp K      &kp L            &kp SEMI   &kp SQT
&kp LSHFT  &kp Z     &kp X     &kp C     &kp V        &kp B      &kp N   &kp M        &kp COMMA  &kp PERIOD       &kp SLASH  &kp ENTER
&kp LCTRL  &kp LGUI  &kp LALT  &kp RALT  &mo L_LOWER  &kp SPACE          &mo L_RAISE  &kp LEFT   &kp DOWN         &kp UP     &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        lower_layer {
            label = "Lower";
            bindings = <
                                                                                             &trans  &trans             &trans
&trans    &kp F1         &kp F2    &kp F3     &kp F4     &kp F5      &kp F6  &kp F7  &kp F8  &kp F9  &kp F10            &kp F11
&trans    &kp PAGE_UP    &kp HOME  &kp UP     &kp END    &kp INSERT  &trans  &kp N7  &kp N8  &kp N9  &kp KP_NUM         &kp F12
&kp CAPS  &kp PAGE_DOWN  &kp LEFT  &kp DOWN   &kp RIGHT  &kp DEL     &trans  &kp N4  &kp N5  &kp N6  &trans             &trans
&trans    &trans         &trans    &trans     &trans     &trans      &trans  &kp N1  &kp N2  &kp N3  &trans             &trans
&trans    &trans         &trans    &kp RCTRL  &trans     &trans              &trans  &kp N0  &kp N0  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        raise_layer {
            label = "Raise";
            bindings = <
                                                                                                                       &trans    &trans             &trans
&trans        &kp F1          &kp F2          &kp F3          &kp F4           &kp F5    &kp F6  &kp F7     &kp F8     &kp F9    &kp F10            &kp F11
&trans        &msc SCRL_UP    &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &mkp MB5  &trans  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT           &kp F12
&kp CAPSLOCK  &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MB4  &trans  &kp UNDER  &kp PLUS   &kp LBRC  &kp RBRC           &trans
&trans        &trans          &msc SCRL_LEFT  &mkp MCLK       &msc SCRL_RIGHT  &trans    &trans  &trans     &trans     &kp LPAR  &kp RPAR           &trans
&trans        &trans          &trans          &trans          &trans           &trans            &trans     &trans     &trans    &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        func_layer {
            label = "Function";
            bindings = <
                                                                                                              &trans  &trans  &trans
&out OUT_TOG  &bt_sel_0       &bt_sel_1     &bt_sel_2     &bt_sel_3       &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans          &trans        &trans        &trans          &trans        &trans  &trans  &trans  &trans  &none   &trans
&trans        &trans          &trans        &trans        &trans          &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans        &studio_unlock  &trans        &none         &trans          &none         &trans  &trans  &trans  &trans  &trans  &trans
&bootloader   &trans          &trans        &trans        &trans          &trans                &trans  &trans  &trans  &trans  &bt BT_CLR
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        tri_layer {
            label = "TriFunction";
            bindings = <
                                                                                                              &trans  &trans  &trans
&out OUT_TOG  &bt_sel_0       &bt_sel_1     &bt_sel_2     &bt_sel_3       &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans          &trans        &trans        &trans          &trans        &trans  &trans  &trans  &trans  &none   &trans
&trans        &trans          &trans        &trans        &trans          &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans        &studio_unlock  &trans        &none         &trans          &none         &trans  &trans  &trans  &trans  &trans  &trans
&bootloader   &trans          &trans        &trans        &trans          &trans                &trans  &trans  &trans  &trans  &bt BT_CLR
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <L_LOWER L_RAISE>;
            then-layer = <L_TRI>;
        };
    };
};
